# ==================== 大模型 ====================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-max
LLM_LIGHT_MODEL=qwen-plus
VL_MODEL=qwen-vl-max
LLM_DEFAULT_TEMPERATURE=0.2
LLM_ANSWER_TEMPERATURE=0.3

# ==================== 向量与重排 ====================
BGE_M3_PATH=./models/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
BGE_BATCH_SIZE=16
BGE_DENSE_DIM=1024
BGE_RERANKER_LARGE=./models/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0
RERANK_SCORE_THRESHOLD=0.2

# ==================== Milvus ====================
MILVUS_URL=http://127.0.0.1:19530
MILVUS_TOKEN=
TRIP_CHUNKS_COLLECTION=trip_chunks
TRIP_ENTITIES_COLLECTION=trip_entities

# ==================== Mongo / MinIO ====================
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=tripmind
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tripmind
MINIO_SECURE=0

# ==================== 外部能力 ====================
# 高德 Web 服务 key（不是 JS API key），只在服务端使用
AMAP_KEY=
AMAP_IMPORT_KEY=
AMAP_QPS=3
AMAP_TIMEOUT=1.2
AMAP_DAILY_QUOTA=5000
WEATHER_PROVIDER=amap
QWEATHER_KEY=
CACHE_TTL_MAP=21600
CACHE_TTL_WEATHER=1800
CACHE_TTL_IMAGE=86400
IMAGE_MAX_PER_ANSWER=3
ENABLE_WEB_IMAGE=false

# ==================== 业务 ====================
TRIP_DATA_DIR=./data
TRIP_DEFAULT_CITY=三亚
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=20
RERANK_TOP_K=6
CONTEXT_CHAR_BUDGET=2000

# ==================== 质量与可追责 ====================
GUARD_ENABLED=true
TRACE_ENABLED=true
MEMORY_ENABLED=true
CRITIC_MAX_RETRY=1
GOAL_MAX_RETRY=1
HISTORY_KEEP_TURNS=3
FACT_MAX_AGE_H=6
EVIDENCE_MIN_COVERAGE=3
PROFILE_WRITE_MODE=explicit
MAX_INPUT_CHARS=2000

# ==================== 行程 ====================
PLAN_MAX_DAYS=10
PLAN_DAY_MINUTES=600
PLAN_REVERSE_LIMIT=120
PLAN_MAX_RETRY=2

# ==================== 日志 ====================
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# ==================== 文档解析（可选） ====================
MINERU_ENABLED=0
MINERU_BASE_URL=http://127.0.0.1:8888
